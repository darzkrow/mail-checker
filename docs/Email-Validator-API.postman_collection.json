              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/validate-email",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "validate-email"]
            }
          },
