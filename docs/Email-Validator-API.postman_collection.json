      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "console.log('Starting Email Validator API Test Suite');",
          "console.log('Base URL:', pm.variables.get('base_url'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Tests comunes para todas las respuestas",
          "pm.test('Response time is less than 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "// Test para respuestas exitosas (200)",
          "if (pm.response.code === 200) {",
          "    pm.test('Status code is 200', function () {",
          "        pm.response.to.have.status(200);",
          "    });",
          "    ",
          "    pm.test('Response has required fields', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('email');",
          "        pm.expect(jsonData).to.have.property('is_valid_syntax');",
          "        pm.expect(jsonData).to.have.property('has_mx_records');",
          "        pm.expect(jsonData).to.have.property('is_deliverable');",
          "        pm.expect(jsonData).to.have.property('reason');",
          "    });",
          "}",
          "",
          "// Test para errores 4xx/5xx",
          "if (pm.response.code >= 400 && pm.response.code < 600) {",
          "    pm.test('Error response has correct structure', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('error');",
          "        pm.expect(jsonData).to.have.property('status');",
          "        pm.expect(jsonData.status).to.equal(pm.response.code);",
          "    });",
          "}"
        ]
      }
    }
  ],
