# API Key maestra - ¡CAMBIA ESTO EN PRODUCCIÓN!
API_KEY=your-super-secret-api-key-change-me-in-production

# Credenciales preconfiguradas del Administrador para el Dashboard
ADMIN_USER=Administrator
# ADMIN_PASSWORD se hashea automáticamente en el primer arranque.
# Para configurar un hash personalado, establece ADMIN_PASSWORD_SALT y ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=admin12345

# Dominios permitidos para CORS (separados por comas)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Puerto del servidor
PORT=3000

# Rate limit: solicitudes por segundo por IP
RATE_LIMIT_QPS=10

# Nivel de logging: debug, info, warn, error
RUST_LOG=info

# Variables para hash de contraseña administrativo (opcional)
# Si no se especifican, se generarán automáticamente en el primer arranque
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=

# ===========================================
# CONFIGURACIÓN SMTP (Verificación real de entregabilidad)
# ===========================================
# Activar verificación SMTP real (RCPT TO)
SMTP_VERIFICATION_ENABLED=false

# Timeouts SMTP (segundos)
SMTP_CONNECT_TIMEOUT_SECS=10
SMTP_COMMAND_TIMEOUT_SECS=10
SMTP_TOTAL_TIMEOUT_SECS=30

# Reintentos en fallos temporales (greylisting 4xx)
SMTP_MAX_RETRIES=2
SMTP_RETRY_BACKOFF_SECS=5

# Puertos SMTP
SMTP_PRIMARY_PORT=25
SMTP_SUBMISSION_PORT=587
SMTP_SMTPS_PORT=465

# Dominio para EHLO
SMTP_HELO_DOMAIN=email-validator.local

# Remitente para MAIL FROM (vacío = null sender <>)
SMTP_MAIL_FROM=

# Aceptar certificados TLS inválidos (SOLO PARA TESTING)
SMTP_DANGER_ACCEPT_INVALID_CERTS=false

# Detección de dominios catch-all
SMTP_ENABLE_CATCH_ALL_DETECTION=true
